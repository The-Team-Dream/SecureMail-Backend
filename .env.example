DATABASE_URL="postgresql://postgres:0000@localhost:5432/securemail?schema=public"

# mail
MAIL_HOST=""
SMTP_USERNAME=""
SMTP_PASSWORD=""
 
# Redis (for Bull queue)
REDIS_HOST=""
REDIS_PORT=""

# Encryption (min 32 chars for AES-256)
ENCRYPTION_KEY=""

# Gmail OAuth2
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""

# Microsoft/Outlook OAuth2
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Frontend (for OAuth redirect URIs)
FRONTEND_URL=""

# Mailbox storage limit in bytes (default 1GB; LOW_MAILBOX_SPACE triggers at 80%)
MAILBOX_STORAGE_LIMIT_BYTES=""

# Admin seed (for first admin user creation: pnpm run seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
