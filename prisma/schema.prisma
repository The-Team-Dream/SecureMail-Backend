// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int            @id @default(autoincrement())
  email                String         @unique
  provider             String         @default("local")
  username             String?
  passwordHash         String?
  avatar               String?
  otpCode              String?
  otpExpires           DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  oauthId              String?
  oauthAccessToken     String?
  oauthRefreshToken    String?
  isVerified           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  mailBoxes            MailBox[]
  sessions             UserSession[]
  settings             UserSetting[]
  notifications        Notification[]
}

model UserSession {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  refreshToken String
  userAgent    String
  ipAddress    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model UserSetting {
  id                   Int      @id @default(autoincrement())
  user                 User     @relation(fields: [userId], references: [id])
  userId               Int
  notificationsEnabled Boolean
  createdAt            DateTime @default(now())
}

model MailBox {
  id            Int            @id @default(autoincrement())
  user          User           @relation(fields: [userId], references: [id])
  userId        Int
  emailAddress  String
  provider      EmailProviders
  displayName   String
  isActive      Boolean
  lastSyncedAt  DateTime
  createdAt     DateTime
  imapConfig    ImapConfig?
  smtpConfig    SmtpConfig?
  oauthToken    OauthToken?
  folders       Folder[]
  emails        Email[]
  notifications Notification[]
  syncLog       SyncLog[]
}

enum EmailProviders {
  GMAIL
  OUTLOOK
  YAHOO
  CUSTOM
}

model ImapConfig {
  id        Int          @id @default(autoincrement())
  mailBox   MailBox      @relation(fields: [mailBoxId], references: [id])
  mailBoxId Int          @unique
  host      String
  port      Int
  secure    Boolean
  authType  ImapAuthType
  createdAt DateTime     @default(now())
}

enum ImapAuthType {
  OAUTH
  PASSWORD
}

model SmtpConfig {
  id        Int          @id @default(autoincrement())
  mailBox   MailBox      @relation(fields: [mailBoxId], references: [id])
  mailBoxId Int          @unique
  host      String
  port      Int
  secure    String
  authType  SmtpAuthType
  createdAt DateTime     @default(now())
}

enum SmtpAuthType {
  OAUTH
  PASSWORD
}

model OauthToken {
  id                    Int      @id @default(autoincrement())
  mailBox               MailBox  @relation(fields: [mailBoxId], references: [id])
  mailBoxId             Int      @unique
  provider              String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  scope                 String
  createdAt             DateTime @default(now())
}

model Folder {
  id        Int        @id @default(autoincrement())
  mailBox   MailBox    @relation(fields: [mailBoxId], references: [id])
  mailBoxId Int
  name      String
  type      FolderType
  remoteId  String
  emails    Email[]
  createdAt DateTime   @default(now())

  @@index([mailBoxId])
  @@index([remoteId])
}

enum FolderType {
  INBOX
  SENT
  SPAM
  TRASH
  CUSTOM
}

model Email {
  id            Int             @id @default(autoincrement())
  mailBox       MailBox         @relation(fields: [mailBoxId], references: [id])
  mailBoxId     Int
  folder        Folder          @relation(fields: [folderId], references: [id])
  folderId      Int
  messageId     String
  subject       String
  recipientType RecipientType[]
  bodyText      String
  bodyHtml      String
  isRead        Boolean
  isFlagged     Boolean
  isSpam        Boolean
  receivedAt    DateTime
  createdAt     DateTime        @default(now())
  emailFlag     EmailFlag?
  attachments   Attachment[]
  notifications Notification[]

  @@index([mailBoxId])
  @@index([folderId])
  @@index([receivedAt])
  @@index([messageId])
}

enum RecipientType {
  FROM
  TO
  CC
  BCC
}

model EmailFlag {
  id        Int           @id @default(autoincrement())
  email     Email         @relation(fields: [emailId], references: [id])
  emailId   Int           @unique
  type      EmailFlagType
  createdAt DateTime      @default(now())
}

enum EmailFlagType {
  SEEN
  FLAGGED
  ANSWERED
}

model Attachment {
  id          Int      @id @default(autoincrement())
  email       Email    @relation(fields: [emailId], references: [id])
  emailId     Int
  mimiType    String
  size        Int
  storagePath String
  createdAt   DateTime @default(now())
}

model Notification {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id])
  userId    Int
  mailBox   MailBox          @relation(fields: [mailBoxId], references: [id])
  mailBoxId Int
  email     Email            @relation(fields: [emailId], references: [id])
  emailId   Int
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([mailBoxId])
  @@index([userId])
  @@index([isRead])
}

enum NotificationType {
  NEW_EMAIL
  SECURITY_ALERT
}

model SyncLog {
  id           Int        @id @default(autoincrement())
  mailBox      MailBox    @relation(fields: [mailBoxId], references: [id])
  mailBoxId    Int
  status       SyncStatus
  errorMessage String
  syncedAt     DateTime
}

enum SyncStatus {
  SUCCESS
  FAILED
}
