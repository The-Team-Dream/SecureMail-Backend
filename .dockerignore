# ── Version control ───────────────────────────────────────────────
.git
.gitignore
.gitmodules

# ── IDE / tooling ────────────────────────────────────────────────
.vscode
.turbo
.cache

# ── Build output (rebuilt inside container) ───────────────────────
dist
build

# ── Dependencies (reinstalled inside container) ───────────────────
node_modules

# ── Prisma generated client (regenerated inside container) ────────
generated

# ── Test files ───────────────────────────────────────────────────
test
**/*.spec.ts
**/*.e2e-spec.ts
jest.setup.ts
coverage

# ── Logs ─────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*

# ── Env files (pass at runtime via --env-file or docker-compose) ──
.env
.env.*
!.env.example

# ── Misc ─────────────────────────────────────────────────────────
README.md
API-Docs.md
*.md
*.zip
src.zip
