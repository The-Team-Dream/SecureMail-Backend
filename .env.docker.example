# ─────────────────────────────────────────────────────────────────────────────
# SecureMail-Backend — FULL STACK (Docker network) mode
# Used by root docker-compose.yml via: env_file: ./SecureMail-Backend/.env.docker
#
# HOW TO USE:
#   cp .env.docker.example .env.docker
#   Then fill in your real values below
#
# gRPC service names match Docker Compose service names in the root compose:
#   ai:50051      → SecureMail-Ai container on securemail-net
#   malware:50052 → SecureMail-Malware container on securemail-net
# ─────────────────────────────────────────────────────────────────────────────

# Database — 'postgres' is the service name in root docker-compose.yml
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/securemail?schema=public"

# gRPC — Docker service names (resolved via securemail-net bridge network)
AI_AGENT_GRPC_URL=ai:50051
MALWARE_GRPC_URL=malware:50052

# JWT
JWT_SECRET=your-very-long-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Mail (SMTP)
MAIL_HOST="smtp.gmail.com"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Redis — 'redis' is the service name in root docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379

# Encryption key (min 32 characters for AES-256)
ENCRYPTION_KEY=your-secure-encryption-key-at-least-32-characters

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Microsoft OAuth2
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common

# Frontend URL (for CORS allowlist)
FRONTEND_URL=http://localhost:3001

# Mailbox storage (default 1 GB)
MAILBOX_STORAGE_LIMIT_BYTES=1073741824

# Admin seed credentials
ADMIN_EMAIL=admin@securemail.local
ADMIN_PASSWORD=Admin123!

# Cloudinary (avatar / attachment storage)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Threat Intelligence
ABUSEIPDB_API_KEY=your-abuseipdb-api-key