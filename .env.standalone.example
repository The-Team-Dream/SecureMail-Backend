# Copy this file: cp .env.standalone.example .env.standalone
# Then fill in your real values

DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/securemail?schema=public"

AI_AGENT_GRPC_URL=localhost:50051
MALWARE_GRPC_URL=localhost:50052

JWT_SECRET=your-very-long-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

MAIL_HOST="smtp.gmail.com"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

REDIS_HOST=redis
REDIS_PORT=6379

ENCRYPTION_KEY=your-secure-encryption-key-at-least-32-characters

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common

FRONTEND_URL=http://localhost:3001
MAILBOX_STORAGE_LIMIT_BYTES=1073741824

ADMIN_EMAIL=admin@securemail.local
ADMIN_PASSWORD=Admin123!

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

ABUSEIPDB_API_KEY=your-abuseipdb-api-key